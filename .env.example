# Copy to .env for LOCAL testing only. NEVER commit the real .env.
# On Vercel / Render, add these in the dashboard's Environment Variables instead.

# Supabase (database)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Firebase Admin: whole serviceAccountKey.json as ONE line (or base64). Verifies Google sign-in.
FIREBASE_SERVICE_ACCOUNT=

# Gmail OTP sender (Brevo)
BREVO_API_KEY=
BREVO_SENDER=

# Any long random text; signs login sessions. MUST be the same on Vercel and Render if both share one database.
SESSION_SECRET=
